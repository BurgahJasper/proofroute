# Hosted default. Use only the credentials for the selected provider.
INFERENCE_PROVIDER=nvidia_hosted
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=REPLACE_PRIVATELY
# Documented candidate to verify with smoke:providers. Do not invent an ID.
# nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_MODEL=REPLACE_WITH_TESTED_MODEL_ID

# Only for Brev-hosted inference; leave unused on the hosted path.
NIM_BASE_URL=
NIM_API_KEY=

SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
DATABASE_PATH=./data/proofroute.sqlite
APP_ORIGIN=http://localhost:5173
PORT=3000
DEMO_MODE=true
RUN_DEADLINE_MS=45000
MAX_EXTERNAL_CALLS=6
MAX_MODEL_CALLS=4
