{
  "name": "proofroute",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @proofroute/server\" \"npm run dev -w @proofroute/web\"",
    "build": "npm run build -w @proofroute/web",
    "start": "tsx scripts/start.ts",
    "typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 packages/contracts/test/*.test.ts apps/server/test/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 apps/server/test/e2e.test.ts",
    "smoke:providers": "tsx scripts/smoke-providers.ts",
    "eval:heldout": "tsx scripts/eval-heldout.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "eval:baseline": "tsx scripts/eval-baseline.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "concurrently": "10.0.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
